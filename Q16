// a) Arrow function isEven(n)
const isEven = n => n % 2 === 0;

console.log(isEven(4)); // true
console.log(isEven(7)); // false


// b) Ternary operator for Pass/Fail
const marks = 40;
const result = marks >= 35 ? "Pass" : "Fail";

console.log(result); // Pass


// c) Arrow function greet(name) with default using ternary
const greet = name => `Hello ${name || "Guest"}`;

console.log(greet("Sam"));   // Hello Sam
console.log(greet());        // Hello Guest
