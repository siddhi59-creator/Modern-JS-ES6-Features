console.log("\n=== 10. Arrow Function Shorthands ===");

// 10(a)
const add = (x, y) => x + y;
console.log(add(3, 4));

// 10(b)
const isAdult = age => age >= 18;
console.log(isAdult(20));

// 10(c)
const double = n => n * n;
console.log(double(6));




console.log("\n=== 11. Spread Operator (Arrays & Objects) ===");

// 11(a)
const original = [1, 2, 3];
const cloned = [...original];
console.log(cloned);

// 11(b)
const with100 = [100, ...original];
console.log(with100);

// 11(c)
const objA = { name: "Bob", age: 25 };
const objB = { age: 30, city: "Pune" };
const finalMerged = { ...objA, ...objB };
console.log(finalMerged);



console.log("\n=== 12. Optional Chaining – More Practice ===");

// 12(a)
const user = {
  name: "Alex",
  address: { city: "Bangalore" }
};
console.log(user?.address?.city);

// 12(b)
console.log(user?.job?.title); // undefined

