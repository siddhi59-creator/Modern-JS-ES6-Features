console.log("=== 1. Template Literals ===");

// 1(a)
console.log(`5 + 7 = ${5 + 7}`);

// 1(b) Multi-line string
const multiLine = `
Line 1
Line 2
Line 3
`;
console.log(multiLine);

// 1(c)
const firstName = "John";
const lastName = "Doe";
console.log(`Full name: ${firstName} ${lastName}`);



console.log("\n=== 2. Arrow Functions & this ===");

// 2(a)
const square = n => n * n;
console.log(square(5));

// 2(b) Explanation demo
const obj1 = {
  value: 50,
  test: () => console.log("Arrow this.value =", this.value)
};
obj1.test(); // undefined because arrow functions DON’T bind their own `this`

// 2(c) Correct version
const obj2 = {
  value: 50,
  test() {
    console.log("Normal function this.value =", this.value);
  }
};
obj2.test();



console.log("\n=== 3. Rest, Spread & Copying Objects ===");

// 3(a)
const product = { name: "Pen", price: 10 };
const copyProduct = { ...product };
console.log(copyProduct);

// 3(b)
const aObj = { x: 1 };
const bObj = { y: 2 };
const mergedObj = { ...aObj, ...bObj };
console.log(mergedObj);

// 3(c)
const maxValue = (...nums) => Math.max(...nums);
console.log(maxValue(5, 10, 2, 40));



console.log("\n=== 4. Destructuring & Optional Chaining ===");

// 4(a)
const arr = [10, 20, 30];
const [a, b] = arr;
console.log(a, b);

// 4(b)
const laptop = { brand: "Dell", ram: "8GB" };
const { brand } = laptop;
console.log(brand);

// 4(c)
const info = {};
console.log(info?.user?.details); // undefined, no error



console.log("\n=== 5. Scoping (let/var/const) ===");

// 5(a)
for (var i = 0; i < 3; i++) {}
console.log(i); // 3

// 5(b)
try {
  for (let j = 0; j < 3; j++) {}
  console.log(j);
} catch (err) {
  console.log("Error:", err.message);
}

// 5(c)
console.log("const prevents reassigning values for safety & predictability.");



console.log("\n=== 6. Ternary Operator ===");

// 6(a)
const kmph = 65;
let speed = kmph > 60 ? "Fast" : "Normal";
console.log(speed);

// 6(b)
const age = 17;
console.log(age >= 18 ? "Adult" : "Minor");

// 6(c) Nested ternary
const num = -5;
console.log(num > 0 ? "Positive" : num === 0 ? "Zero" : "Negative");



console.log("\n=== 7. Spread, Rest & Arrays ===");

// 7(a)
const nums = [1, 2, 3];
const added = [...nums, 4, 5];
console.log(added);

// 7(b)
const arrA = ["x", "y"];
const arrB = ["z"];
const combinedArr = [...arrA, ...arrB];
console.log(combinedArr);

// 7(c)
const printNames = (...names) => names;
console.log(printNames("A", "B", "C"));



console.log("\n=== 8. Object Destructuring & Shorthand ===");

// 8(a)
const user1 = { id: 101, status: "active" };
const { id, status } = user1;
console.log(id, status);

// 8(b)
const id2 = 101;
const role2 = "admin";
const user2 = { id2, role2 };
console.log(user2);

// 8(c) shorthand object + method
const name2 = "Sam";
const score2 = 90;
const student = {
  name2,
  score2,
  greet() {
    console.log(`Hello ${name2}`);
  }
};
student.greet();



